{ Peroxy radicals. }
#INLINE F90_RCONST 
 !USE constants
 !end of USE statements 
 !
 ! start of executable statements
 RO2 = & 
 C(ind_DECO2) + C(ind_CH3O2) + C(ind_HO3C106O2) + C(ind_C2H5CO3) + & 
   C(ind_HEPTO2) + C(ind_C101O2) + C(ind_C2H5O2) + C(ind_HO6C7O2) + &  
   C(ind_C103O2) + C(ind_HO3C76O2) + C(ind_NC4H9O2) + C(ind_CO3C75O2) + &  
   C(ind_C102O2) + C(ind_C4H9CO3) + C(ind_DIEKBO2) + C(ind_C104O2) + &  
   C(ind_HOCH2CH2O2) + C(ind_CH3CO3) + C(ind_HCOCH2O2) + C(ind_CO3C4CO3) &  
   + C(ind_HO3C5O2) + C(ind_HO1C4O2) + C(ind_C3H7CO3) + C(ind_BUTALO2) + &  
   C(ind_NC3H7O2) + C(ind_NBUTOLAO2) + C(ind_NBUTOLBO2) + C(ind_C71O2) + &  
   C(ind_HO6C7CO3) + C(ind_PEAO2) + C(ind_C5H11CO3) + C(ind_MEKCO2) + &  
   C(ind_C4CHOBO2) + C(ind_C105O2) + C(ind_HOCO3C54O2) + C(ind_HOCH2CO3) &  
   + C(ind_HO2C4O2) + C(ind_C72O2) + C(ind_MEKAO2) + C(ind_CO25C73O2) + &  
   C(ind_CO25C74O2) + C(ind_ETHENO3O2) + C(ind_BU1ENO3O2) + &  
   C(ind_C43NO34O2) + C(ind_HO3C4O2) + C(ind_HCOCO3) + C(ind_HO13C5O2) + &  
   C(ind_HO3C4CO3) + C(ind_HO1C3O2) + C(ind_HOC3H6CO3) + C(ind_IC3H7O2) + &  
   C(ind_CO2C3CO3) + C(ind_CH3COCH2O2) + C(ind_IPROPOLO2) + &  
   C(ind_HO2C3CO3) + C(ind_HYPROPO2) + C(ind_HO1C5O2) + C(ind_HOC2H4CO3) &  
   + C(ind_HO13C4O2) + C(ind_HO1CO3C4O2) + C(ind_C73O2) + C(ind_C74O2) + &  
   C(ind_NO3CH2CO3) + C(ind_CO3C4NO3O2) + C(ind_HO3C3CO3) + &  
   C(ind_BIACETO2) + C(ind_HCOCH2CO3) + C(ind_CO23C4CO3) + &  
   C(ind_CH3CHOHCO3) + C(ind_C51O2) + C(ind_HO13C3CO3) + C(ind_HO2C4CO3) &  
   + C(ind_CO2C4CO3 ) + C(ind_C10356CO4OOH2O2) + C(ind_C103CO5OH2OOH4O2) &
   + C(ind_C103CO5OH2OOH5O2) + C(ind_C7235CO6OOH4O2) + C(ind_HO3C106OOH3O2) 
   
 !CALL mcm_constants(time, temp, M, N2, O2, RO2, H2O) 
 #ENDINLINE 
{above lines go into the SUBROUTINES UPDATE_RCONST and UPDATE_PHOTO}
#EQUATIONS
{1.} 	 CL + NC10H22 = DECO2 : 	5.55D-10 	;
{2.} 	 OH + NC10H22 = DECO2 : 	3.13D-17*TEMP**2*EXP(416/TEMP) 	;
{3.} 	 CL + CH4 = CH3O2 : 	6.6D-12*EXP(-1240/TEMP) 	;
{4.} 	 OH + CH4 = CH3O2 : 	1.85D-12*EXP(-1690/TEMP) 	;
{5.} 	 DECO2 + HO2 = DECOOH : 	KRO2HO2*0.914 	;
{6.} 	 DECO2 + NO = DECNO3 : 	KRO2NO*0.417 	;
{7.} 	 DECO2 + NO = DECO + NO2 : 	KRO2NO*0.583 	;
{8.} 	 DECO2 + NO3 = DECO + NO2 : 	KRO2NO3 	;
{9.} 	 DECO2 = DEC3ONE : 	2.50D-13*0.2*RO2 	;
{10.} 	 DECO2 = DECO : 	2.50D-13*0.6*RO2 	;
{11.} 	 DECO2 = DECOH : 	2.50D-13*0.2*RO2 	;
{12.} 	 CH3O2 + HO2 = CH3OOH : 	3.8D-13*EXP(780/TEMP)*(1-1/(1+498*EXP(-1160/TEMP))) 	;
{13.} 	 CH3O2 + HO2 = HCHO : 	3.8D-13*EXP(780/TEMP)*(1/(1+498*EXP(-1160/TEMP))) 	;
{14.} 	 CH3O2 + NO = CH3NO3 : 	2.3D-12*EXP(360/TEMP)*0.001 	;
{15.} 	 CH3O2 + NO = CH3O + NO2 : 	2.3D-12*EXP(360/TEMP)*0.999 	;
{16.} 	 CH3O2 + NO2 = CH3O2NO2 : 	KMT13 	;
{17.} 	 CH3O2 + NO3 = CH3O + NO2 : 	1.2D-12 	;
{18.} 	 CH3O2 = CH3O : 	2*KCH3O2*RO2*7.18*EXP(-885/TEMP) 	;
{19.} 	 CH3O2 = CH3OH : 	2*KCH3O2*RO2*0.5*(1-7.18*EXP(-885/TEMP)) 	;
{20.} 	 CH3O2 = HCHO : 	2*KCH3O2*RO2*0.5*(1-7.18*EXP(-885/TEMP)) 	;
{21.} 	 DECOOH = DECO + OH : 	J(41) 	;
{22.} 	 OH + DECOOH = DEC3ONE + OH : 	3.79D-11 	;
{23.} 	 DECNO3 = DECO + NO2 : 	J(54) 	;
{24.} 	 OH + DECNO3 = DEC3ONE + NO2 : 	7.67D-12 	;
{25.} 	 DECO = HO3C106O2 : 	2.58D+11*EXP(-3430/TEMP) 	;
{26.} 	 DEC3ONE = C2H5CO3 + HEPTO2 : 	J(22) 	;
{27.} 	 OH + DEC3ONE = C101O2 : 	1.21D-11 	;
{28.} 	 OH + DECOH = DEC3ONE + HO2 : 	2.01D-11 	;
{29.} 	 CH3OOH = CH3O + OH : 	J(41) 	;
{30.} 	 OH + CH3OOH = CH3O2 : 	5.3D-12*EXP(190/TEMP)*0.6 	;
{31.} 	 OH + CH3OOH = HCHO + OH : 	5.3D-12*EXP(190/TEMP)*0.4 	;
{32.} 	 HCHO = CO + HO2 + HO2 : 	J(11) 	;
{33.} 	 HCHO = H2 + CO : 	J(12) 	;
{34.} 	 NO3 + HCHO = HNO3 + CO + HO2 : 	5.5D-16 	;
{35.} 	 OH + HCHO = HO2 + CO : 	5.4D-12*EXP(135/TEMP) 	;
{36.} 	 CH3NO3 = CH3O + NO2 : 	J(51) 	;
{37.} 	 OH + CH3NO3 = HCHO + NO2 : 	4.0D-13*EXP(-845/TEMP) 	;
{38.} 	 CH3O = HCHO + HO2 : 	7.2D-14*EXP(-1080/TEMP)*O2 	;
{39.} 	 CH3O2NO2 = CH3O2 + NO2 : 	KMT14 	;
{40.} 	 CH3OH + OH = HO2 + HCHO : 	2.85D-12*EXP(-345/TEMP) 	;
{41.} 	 HO3C106O2 + HO2 = HO3C106OOH : 	KRO2HO2*0.914 	;
{42.} 	 HO3C106O2 + NO = HO3C106NO3 : 	KRO2NO*0.167 	;
{43.} 	 HO3C106O2 + NO = HO3C106O + NO2 : 	KRO2NO*0.833 	;
{44.} 	 HO3C106O2 + NO3 = HO3C106O + NO2 : 	KRO2NO3 	;
{45.} 	 HO3C106O2 = HO36C10 : 	2.50D-13*0.2*RO2 	;
{46.} 	 HO3C106O2 = HO3C106O : 	2.50D-13*0.6*RO2 	;
